# Copy to .env (read by docker compose), .env.development, .env.production
# and .env.test. Never commit the copies — only this template is tracked.

# Postgres (docker-compose.yml starts one container; the app and the
# migration runner connect to it directly)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=library
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# In .env.test the database name MUST end with `_test`. The test helpers
# refuse to truncate anything else, so a typo can never wipe the dev data.
# Example: POSTGRES_DB=library_test

# HTTP port the API listens on (default 8000)
PORT=8000

# Auth-lite: the single API key clients must send in the X-API-Key header.
# Pick any long random string. Never commit the real one.
API_KEY=change-me
